{
  "name": "tankerkoenigv4",
  "type": "commonjs",
  "version": "1.0.5",
  "description": "A simple wrapper around the version 4 of the creativecommons.tankerkoenig.de API for fetching real-time gas prices in Germany",
  "author": "",
  "license": "ISC",
  "homepage": "https://github.com/hugohabicht01/tankerkoenigv4",
  "repository": {
    "type": "git",
    "url": "https://github.com/hugohabicht01/tankerkoenigv4.git"
  },
  "main": "built/index.js",
  "types": "built/index.d.ts",
  "release": {
    "branches": [
      "master"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/built"
  ],
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "build": "tsc",
    "prepublish": "npm run build",
    "refreshInterfaces": "curl https://creativecommons.tankerkoenig.de/swagger/tankerkoenig.yaml -o tankerkoenig.yaml && npx -y openapi-typescript --output src/schema.ts",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "defu": "^6.1.4",
    "ofetch": "^1.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.27.0",
    "@types/jest": "^28.1.8",
    "@types/node": "^18.19.130",
    "dotenv": "^16.6.1",
    "eslint": "^8.22.0",
    "jest": "^30.3.0",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.4.6",
    "typescript": "^4.9.5"
  }
}
